            "value" : "Orbit zeigt deine Termine an und legt nach deiner Bestätigung neue Termine an."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Orbit shows your events and creates new events after you confirm."
          }
        }
      }
    },
    "NSContactsUsageDescription" : {
      "comment" : "Privacy - Contacts Usage Description",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Orbit durchsucht deine Kontakte, um Namen in E-Mail-Adressen aufzulösen und Kontakte in der Suche anzuzeigen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Orbit searches your contacts to resolve names to email addresses and to show contacts in search results."
          }
        }
      }
    },
    "NSDesktopFolderUsageDescription" : {
      "comment" : "Privacy - Desktop Folder Usage Description",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Orbit durchsucht deinen Schreibtisch, damit passende Dateien schon beim Tippen erscheinen, und liest Dateien, wenn du danach fragst."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Orbit searches your Desktop folder so matching files appear as you type, and reads files when you ask for them."
          }
        }
      }
    },
    "NSDocumentsFolderUsageDescription" : {
      "comment" : "Privacy - Documents Folder Usage Description",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Orbit durchsucht deinen Dokumente-Ordner, damit passende Dateien schon beim Tippen erscheinen, und liest Dateien, wenn du danach fragst."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Orbit searches your Documents folder so matching files appear as you type, and reads files when you ask for them."
          }
        }
      }
    },

    },
    "NSAppleEventsUsageDescription" : {
      "comment" : "Privacy - AppleEvents Sending Usage Description (Mail, Notes, Photos, Finder, System Events)",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Orbit steuert Mail, Notizen, Fotos, den Finder und System Events, um deine Anfragen auszuführen, zum Beispiel um Mails zu durchsuchen, einen Entwurf zu öffnen, ein Foto in Fotos zu zeigen, die Auswahl im Finder zu übernehmen oder den Dunkelmodus einzuschalten."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Orbit controls Mail, Notes, Photos, Finder and System Events to carry out your requests, for example to search your mail, open a draft, show a photo in Photos, use the selection in Finder or turn on Dark Mode."
          }
        }
      }
    },
    "NSCalendarsFullAccessUsageDescription" : {
      "comment" : "Privacy - Calendars Full Access Usage Description (macOS 14+)",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Orbit zeigt deine Termine an und legt nach deiner Bestätigung neue Termine an."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Orbit shows your events and creates new events after you confirm."
          }
        }
      }
    },
    "NSCalendarsUsageDescription" : {
      "comment" : "Privacy - Calendars Usage Description (macOS 13 and earlier)",

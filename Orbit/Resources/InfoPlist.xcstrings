      "comment" : "Privacy - Photo Library Usage Description",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Orbit sucht Fotos nach Datum, Alben und Favoriten und zeigt sie als Vorschau an."
          }

            "value" : "Öffne Antwort in Mail…"
          }
        }
      }
    },
    "Opens Anthropic’s sign-in in your browser. Orbit never sees your credentials." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Öffnet die Anmeldung von Anthropic im Browser. Orbit sieht deine Zugangsdaten nicht."
          }
        }
      }
    },
    "Opens Anthropic’s sign-in in your browser. Orbit then sends the request again." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Öffnet die Anmeldung von Anthropic im Browser. Danach sendet Orbit die Anfrage erneut."
          }
        }
      }
    },
    "Opens or drafts something without sending it. Runs without asking." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Öffnet oder entwirft etwas, ohne es abzuschicken. Läuft ohne Rückfrage."
          }
        }
      }
    },
    "Opens Orbit’s settings under “Permissions”" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Öffnet Orbits Einstellungen unter „Berechtigungen“"
          }
